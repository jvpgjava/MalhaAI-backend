# Copie para .env e preencha (não commitar .env com secrets reais)

DB_HOST=localhost
DB_PORT=5432
DB_NAME=malhaia
DB_USER=postgres
DB_PASSWORD=postgres

PORT=8080

JWT_SECRET=change-me-to-a-long-secret-at-least-256-bits-long-for-hs256!!
JWT_EXPIRATION_MS=86400000

# Em dev o backend também aceita http://localhost:* (qualquer porta do ng serve)
FRONTEND_ORIGIN=http://localhost:4200

# Preferir ABACUS_API_KEY; ABACUSAI_API_KEY também é aceito
ABACUS_API_KEY=
ABACUSAI_API_KEY=
ABACUS_BASE_URL=https://routellm.abacus.ai/v1
ABACUS_MODEL_NAME=claude-sonnet-5

GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-embedding-001
EMBEDDING_MODEL=gemini-embedding-001
